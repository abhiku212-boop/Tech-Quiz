# ---- required ----------------------------------------------------------
# MongoDB. Only used to remember the last few questions so they do not repeat.
# Free cloud: https://www.mongodb.com/cloud/atlas  (copy the connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/tgquiz?appName=Cluster0

# From @BotFather on Telegram, after /newbot
TELEGRAM_BOT_TOKEN=

# Public chat: @yourchannel     Private chat: -1001234567890
# The bot must be an ADMIN here with "Post messages" enabled.
TELEGRAM_CHANNEL_ID=@yourchannel

# ---- optional AI generation ---------------------------------------------
# Free-tier Gemini API key: https://aistudio.google.com/apikey
# If unset or quota-limited, the bot automatically uses its curated question bank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Forum topic to post into, e.g. an "Aptitude" section. Only forum supergroups
# have topics. Find the id in any message link from that topic:
# https://t.me/yourchannel/1155/42  ->  1155
# Leave blank to post to General.
TELEGRAM_TOPIC_ID=

# ---- optional -----------------------------------------------------------
# beginner | intermediate | advanced | mixed
QUIZ_DIFFICULTY=mixed
# Comma separated. Leave unset to use the built-in JavaScript/full-stack interview syllabus.
# QUIZ_TOPICS=JavaScript output questions,React hooks and rendering,Node.js event loop and modules
# How long the quiz stays open, in seconds, counted by Telegram from the moment
# it is posted. Telegram shows the countdown on the poll and closes it itself.
# 86400 = 24 hours. Accepted range is 5-2628000 (about 30 days); 0 = no timer.
QUIZ_OPEN_PERIOD=86400
# Safety net, normally left at 0: on its next run the job stops any poll still
# open this many hours after posting. Only useful for polls that went out with
# no timer. 0 = never.
QUIZ_CLOSE_AFTER_HOURS=0
# 0 shows "N voted" and who picked what. 1 hides voters. Channels are always
# anonymous whatever this says - Telegram refuses anything else there.
QUIZ_ANONYMOUS=1
# How many recently posted questions are remembered to reduce repeats.
# Keep this below the size of the curated question bank.
QUIZ_HISTORY_LIMIT=20
# Refuse a second post inside this many hours. 0 disables the guard.
QUIZ_MIN_GAP_HOURS=20

